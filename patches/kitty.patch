+}
+
+extern PyTypeObject Screen_Type;
+
+PYWRAP1(set_kitilix_sidebar_data) {
+    id_type os_window_id;
+    PyObject *screen;
+    WindowGeometry g = {0};
+    PA("KOIIII", &os_window_id, &screen, &g.left, &g.top, &g.right, &g.bottom);
+    WITH_OS_WINDOW(os_window_id)
+    WindowRenderData *d = &os_window->kitilix_sidebar_data;
+    if (screen == Py_None) {
+        Py_CLEAR(d->screen);
+    } else if (PyObject_TypeCheck(screen, &Screen_Type)) {
+        if (d->vao_idx < 0) d->vao_idx = create_cell_vao();
+        init_window_render_data(d, g, (Screen *)screen);
+    } else {
+        PyErr_SetString(PyExc_TypeError, "Expected a Kitty Screen");
+        return NULL;
+    }
+    os_window->needs_render = true;
+    END_WITH_OS_WINDOW
+    Py_RETURN_NONE;
+}
+
+PYWRAP1(capture_kitilix_tab) {
+    id_type os_window_id, tab_id;
+    unsigned width, height;
+    PA("KKII", &os_window_id, &tab_id, &width, &height);
+    WITH_TAB(os_window_id, tab_id)
+    return capture_kitilix_tab(osw, tab, MIN(width, 300u), MIN(height, 300u));
+    END_WITH_TAB
+    Py_RETURN_NONE;
