+// Paint a tab into a private render target without changing window focus or
+// presenting the result. Sample only the terminal area through Kitty's blit.
+PyObject *
+capture_kitilix_tab(OSWindow *os_window, Tab *tab, unsigned max_width, unsigned max_height) {
+    Region central = {0}, tab_bar = {0};
+    os_window_regions(os_window, &central, &tab_bar);
+    unsigned vw = os_window->viewport_width, vh = os_window->viewport_height;
+    long width = central.right - central.left, height = central.bottom - central.top;
+    if (width <= 0 || height <= 0 || !max_width || !max_height || !os_window->handle) Py_RETURN_NONE;
+    double scale = MIN(1., MIN((double)max_width / width, (double)max_height / height));
+    unsigned dw = MAX(1u, (unsigned)(width * scale)), dh = MAX(1u, (unsigned)(height * scale));
+    PyObject *pixels = PyBytes_FromStringAndSize(NULL, (Py_ssize_t)dw * dh * 4);
+    if (!pixels) return NULL;
+
+    make_os_window_context_current(os_window);
+    set_gpu_viewport(vw, vh);
+    GLuint scene_tex = 0, scene_fbo = 0, thumb_tex = 0, thumb_fbo = 0;
+    setup_texture_as_render_target(vw, vh, &scene_tex, &scene_fbo);
+    bool needs_layers = os_window->needs_layers;
+    os_window->needs_layers = true;
+    unsigned visible = 0;
+    color_type background = OPT(background);
+    if (tab->active_window < tab->num_windows) {
+        Screen *screen = tab->windows[tab->active_window].render_data.screen;
+        if (screen) background = colorprofile_to_color(screen->color_profile, screen->color_profile->overridden.default_bg,
+                                                       screen->color_profile->configured.default_bg).rgb;
+    }
+    for (unsigned i = 0; i < tab->num_windows; i++) {
+        const Window *w = tab->windows + i;
+        if (w->visible && w->render_data.screen) visible++;
+    }
+    blank_canvas(1.f, background, false);
+    draw_bg_image(os_window, tab);
+    BorderRects *br = &tab->border_rects;
+    draw_borders(br->vao_idx, br->num_border_rects, br->rect_buf, br->is_dirty, background, visible, false, os_window);
+    br->is_dirty = false;
+    monotonic_t now = monotonic();
+    for (unsigned i = 0; i < tab->num_windows; i++) {
+        Window *w = tab->windows + i;
+        WindowRenderData *d = &w->render_data;
+        if (!w->visible || !d->screen || d->geometry.right <= d->geometry.left || d->geometry.bottom <= d->geometry.top) continue;
+        bool active = tab->active_window == i;
+        send_cell_data_to_gpu(d->vao_idx, d->screen, os_window);
+        CursorRenderInfo cursor = d->screen->cursor_render_info;
+        d->screen->cursor_render_info.cursor_opacity = 0;
+        d->screen->cursor_render_info.text_blink_opacity = 1;
+        draw_cells(d, os_window, active, false, visible == 1, w, NULL, now);
+        d->screen->cursor_render_info = cursor;
+        WindowRenderData *title = &w->window_title_render_data;
+        if (title->screen && title->geometry.right > title->geometry.left && title->geometry.bottom > title->geometry.top) {
+            send_cell_data_to_gpu(title->vao_idx, title->screen, os_window);
+            draw_cells(title, os_window, active, true, false, NULL, w, now);
+        }
+    }
+    draw_rounded_borders(br, background, visible, false, os_window);
+    os_window->needs_layers = needs_layers;
+
+    setup_texture_as_render_target(dw, dh, &thumb_tex, &thumb_fbo);
+    save_viewport_using_bottom_left_origin(0, 0, dw, dh);
+    bind_program(BLIT_PROGRAM);
+    bind_vertex_array(br->vao_idx);
+    glActiveTexture(GL_TEXTURE0 + GRAPHICS_UNIT);
+    glBindTexture(GL_TEXTURE_2D, scene_tex);
+    glUniform4f(program_uniform_location(BLIT_PROGRAM, "src_rect"), (float)central.left / vw, (float)(vh - central.top) / vh,
+                (float)central.right / vw, (float)(vh - central.bottom) / vh);
+    glUniform4f(program_uniform_location(BLIT_PROGRAM, "dest_rect"), -1, 1, 1, -1);
+    draw_quad(false, 0);
+    glReadPixels(0, 0, dw, dh, GL_RGBA, GL_UNSIGNED_BYTE, PyBytes_AS_STRING(pixels));
+    unbind_vertex_array();
+    restore_viewport();
+    bind_framebuffer_for_output(0);
+    free_framebuffer(&thumb_fbo);
+    free_texture(&thumb_tex);
+    free_framebuffer(&scene_fbo);
+    free_texture(&scene_tex);
+    return Py_BuildValue("NII", pixels, dw, dh);
+}
