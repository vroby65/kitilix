+
+PYWRAP1(set_kitilix_sidebar_image) {
+    id_type os_window_id, window_id;
+    PyObject *rgba;
+    unsigned width, height, row, column, columns, rows;
+    PA("KKO!IIIIII", &os_window_id, &window_id, &PyBytes_Type, &rgba, &width, &height, &row, &column, &columns, &rows);
+    Py_ssize_t length = PyBytes_GET_SIZE(rgba);
+    WITH_OS_WINDOW(os_window_id)
+    Screen *screen = os_window->kitilix_sidebar_data.screen;
+    if (screen) {
+        screen->is_dirty = true;
+        if (!length) {
+            grman_clear(screen->grman, true, screen->cell_size);
+        } else if (width && height && width <= 300 && height <= 300 && length == (Py_ssize_t)width * height * 4 &&
+                   column < screen->columns && columns && columns <= screen->columns - column &&
+                   row < screen->lines && rows && rows <= screen->lines - row) {
+            const GraphicsCommand cmd = {
+                .action = 'T', .format = 32, .data_width = width, .data_height = height,
+                .payload_sz = (size_t)length, .quiet = 2, .cursor_movement = 1,
+                .num_cells = columns, .num_lines = rows, .usage_hints = GRAPHICS_USAGE_HINT_TRANSIENT,
+            };
+            grman_set_window_id(screen->grman, window_id);
+            screen->cursor->x = column;
+            screen->cursor->y = row;
+            grman_handle_command(screen->grman, &cmd, (const uint8_t *)PyBytes_AS_STRING(rgba), screen->cursor, &screen->is_dirty, screen->cell_size);
+        }
+    }
+    END_WITH_OS_WINDOW
+    Py_RETURN_NONE;
+}
